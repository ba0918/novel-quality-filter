{
  "tasks": {
    "check": "deno task lint && deno task fmt:check && deno task test",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test --allow-all",
    "setup-hooks": "deno run --allow-run --allow-read scripts/setup-hooks.ts",
    "spike:lindera": "deno run --allow-all spike/lindera_spike.ts",
    "spike:realdata": "deno run --allow-all spike/realdata_spike.ts",
    "build": "deno run --allow-all scripts/build.ts",
    "build:clean": "rm -rf dist && deno task build"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true
  },
  "imports": {
    "preact": "npm:preact@^10.28.3",
    "preact/": "npm:/preact@10.28.3/",
    "preact/jsx-runtime": "npm:preact@^10.28.3/jsx-runtime",
    "preact/hooks": "npm:preact@^10.28.3/hooks",
    "@preact/signals": "npm:@preact/signals@^2.0.0",
    "lindera-wasm-ipadic-web": "npm:lindera-wasm-ipadic-web@2.3.4",
    "esbuild": "npm:esbuild@^0.27.0",
    "linkedom": "npm:linkedom@^0.18.0",
    "esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1.1.4"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "exclude": ["dist/", "node_modules/", "coverage/", "spike/fixtures/", "tests/fixtures/"]
}
